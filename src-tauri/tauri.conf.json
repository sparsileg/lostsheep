{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lost Sheep",
  "version": "0.1.0",
  "identifier": "org.lostsheep.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.tile.openstreetmap.org"
    },
    "windows": [
      {
        "label": "main",
        "title": "Lost Sheep",
        "width": 1280,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "dmg", "msi", "nsis"],
    "icon": ["assets/icon.png"],
    "externalBin": ["binaries/pdftotext"]
  }
}
