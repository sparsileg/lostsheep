{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LostSheep",
  "identifier": "tools.astryx.lostsheep",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data: asset: https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.tile.openstreetmap.org"
    },
    "windows": [
      {
        "label": "main",
        "title": "Lost Sheep",
        "width": 1280,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["deb", "rpm", "dmg", "msi", "nsis"],
    "externalBin": ["binaries/pdftotext"]
  }
}
